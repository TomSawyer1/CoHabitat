# Configuration Expo — copier vers .env et adapter l'IP

# Appareil physique (Wi‑Fi) : IP du PC qui lance le backend
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.246:3000

# Émulateur Android
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Expo Go / simulateur iOS (même machine que le backend)
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
